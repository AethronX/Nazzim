{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy/ar", "destination": "/privacy-ar", "permanent": false },
    { "source": "/terms/ar", "destination": "/terms-ar", "permanent": false },
    { "source": "/account/delete", "destination": "/delete-account", "permanent": false },
    { "source": "/help", "destination": "/support", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
