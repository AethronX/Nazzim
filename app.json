{
  "expo": {
    "name": "Nazzim",
    "slug": "nazzim",
    "owner": "zoro0077",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nazzim.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Nazzim sends your daily study reminder 15 minutes before your chosen study time, and a gentle nudge if a streak is at risk. You can turn each off in Settings.",
        "CFBundleLocalizations": [
          "en",
          "ar"
        ],
        "CFBundleDevelopmentRegion": "en"
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2257",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nazzim.app",
      "versionCode": 1,
      "permissions": [
        "VIBRATE"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#285CE7",
          "defaultChannel": "reminders"
        }
      ],
      "expo-updates"
    ],
    "scheme": "nazzim",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#112357",
      "dark": {
        "image": "./assets/splash-blank.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B1220"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6fdd8d1c-6272-42de-bf9c-8eb065fefa54",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "6fdd8d1c-6272-42de-bf9c-8eb065fefa54"
      },
      "privacyPolicyUrl": "https://nazzim.app/privacy",
      "termsUrl": "https://nazzim.app/terms",
      "supportUrl": "https://nazzim.app/support"
    }
  }
}
