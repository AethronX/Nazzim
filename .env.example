# Nazzim — required environment variables.
# Copy this file's KEYS into your host (Vercel → Settings → Environment Variables)
# and paste the VALUES from Lovable → Project Settings → Secrets.
# Never commit real values: .env is gitignored on purpose.

# ── Supabase (Lovable Cloud) ───────────────────────────────────────────────
# Server-side. SUPABASE_SERVICE_ROLE_KEY bypasses RLS — server only, never
# expose it to the browser and never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Client-side (inlined into the browser bundle at build time by Vite).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Paddle Billing ─────────────────────────────────────────────────────────
# Checkout stays disabled and the store shows "المتجر قيد الإعداد" until
# PADDLE_CLIENT_TOKEN is set AND each product has a paddlePriceId
# in src/data/products.ts. See SETUP.md.
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=

# ── Resend (order delivery email) ──────────────────────────────────────────
RESEND_API_KEY=
ORDER_FROM_EMAIL=
